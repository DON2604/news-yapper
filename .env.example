# ---------------------------------------------------------------------------
# Aajke Ki Scene? - environment template
#
#   npm run setup    -> copies this file to .env and generates local secrets
#
# Never commit .env. Every value here is read server-side only (FastAPI,
# worker, Next.js server). Nothing is exposed to the browser.
# ---------------------------------------------------------------------------

# Database (Neon dashboard -> Connect; don't commit values)
# DATABASE_URL = pooled connection string for runtime (host contains "-pooler")
# DIRECT_URL   = direct (non-pooled) connection string for Alembic migrations
# `npm run setup` fills these with the local embedded Postgres when empty.
DATABASE_URL=
DIRECT_URL=
# Separate database used by pytest (it is wiped between tests!)
TEST_DATABASE_URL=

# Local embedded Postgres (npm run db:start) - only used for local development
LOCAL_PG_PORT=54329
LOCAL_PG_PASSWORD=
# Defaults to %LOCALAPPDATA%\aajke-ki-scene\pgdata (Windows) or ~/.local/share/aajke-ki-scene/pgdata
LOCAL_PG_DATA_DIR=

# Auth; use only server-side secrets
AUTH_SECRET=
AUTH_TRUST_HOST=false
# Shared HS256 secret: Next.js server mints short-lived tokens, FastAPI verifies them
API_JWT_SECRET=
# OAuth providers (optional). Leave empty to disable a provider.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated e-mails that receive the admin role on sign-in
ADMIN_EMAILS=
# DEMO_MODE only: the demo login named "admin" receives the admin role
DEMO_GRANT_ADMIN=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PROJECT_ID=default
GEMINI_MAX_CONCURRENT=1
GEMINI_MIN_SECONDS_BETWEEN_REQUESTS=15
GEMINI_RPM_BUDGET=2
# Set RPD/TPM from your current AI Studio quota page. The worker refuses to
# call Gemini until GEMINI_RPD_BUDGET is configured.
GEMINI_RPD_BUDGET=
GEMINI_TPM_BUDGET=
GEMINI_BUDGET_SAFETY_FACTOR=0.65
GEMINI_MAX_INPUT_TOKENS_PER_JOB=6000
GEMINI_MAX_OUTPUT_TOKENS_PER_JOB=2048
# Gemini daily quotas reset at midnight Pacific time (per official docs)
GEMINI_DAILY_RESET_TZ=America/Los_Angeles

# Groq - enable only if available and permitted for requested task
GROQ_API_KEY=
GROQ_PROJECT_ID=default
GROQ_MODEL_FAST=
GROQ_MODEL_QUALITY=
GROQ_MODEL_FALLBACK=
GROQ_RPM_BUDGET=
GROQ_RPD_BUDGET=
GROQ_TPM_BUDGET=
GROQ_TPD_BUDGET=
GROQ_MAX_CONCURRENT=1
GROQ_MIN_SECONDS_BETWEEN_REQUESTS=5
GROQ_BUDGET_SAFETY_FACTOR=0.65
GROQ_MAX_INPUT_TOKENS_PER_JOB=6000
GROQ_MAX_OUTPUT_TOKENS_PER_JOB=2048
# json_object works on most Groq models; json_schema only on models that support structured outputs
GROQ_JSON_MODE=json_object
GROQ_DAILY_RESET_TZ=UTC
ENABLE_GROQ=false

# AI orchestration
AI_PROVIDER_ORDER=gemini,groq
AI_GLOBAL_MAX_CONCURRENT=1
AI_ALLOW_PAID_FALLBACK=false
AI_ALLOW_PRIVATE_NOTES_PROVIDER_FALLBACK=false
# Optional JSON override of the task->model routing table (see docs/architecture.md)
AI_TASK_ROUTING_JSON=
AI_MAX_PROVIDER_ATTEMPTS_PER_CYCLE=2
AI_MAX_JOB_ATTEMPTS=4
# Publish AI articles automatically only when every evidence check passes
AI_AUTO_PUBLISH_VALIDATED=true
# Max news batch jobs (each covers up to 3 stories) enqueued per day
AI_DAILY_NEWS_JOB_LIMIT=8
# Share of each provider's daily budget that user Crunch jobs may consume
AI_CRUNCH_DAILY_SHARE=0.3

# Crunch limits (per user)
CRUNCH_MAX_ITEMS=40
CRUNCH_MAX_INPUT_CHARS=12000
CRUNCH_DAILY_LIMIT_PER_USER=10
CRUNCH_COOLDOWN_SECONDS=20

# News optional (adapters for these are not enabled in the MVP)
GUARDIAN_API_KEY=
GNEWS_API_KEY=
NEWSAPI_API_KEY=

# Application
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
ENABLE_LIVE_INGESTION=false
ENABLE_GEMINI=false
DEMO_MODE=true
# Identify the crawler honestly; add a contact URL or e-mail before enabling live ingestion
INGESTION_CONTACT=
