{
  "$defs": {
    "ArticleOut": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "headline_banglish": {
          "maxLength": 180,
          "minLength": 8,
          "title": "Headline Banglish",
          "type": "string"
        },
        "neutral_summary": {
          "maxLength": 1400,
          "minLength": 40,
          "title": "Neutral Summary",
          "type": "string"
        },
        "banglish_summary": {
          "maxLength": 1000,
          "minLength": 20,
          "title": "Banglish Summary",
          "type": "string"
        },
        "category": {
          "enum": [
            "polity",
            "economy",
            "science",
            "international",
            "environment",
            "awards",
            "sports",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "published_event_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Event Date"
        },
        "key_facts": {
          "items": {
            "$ref": "#/$defs/KeyFactOut"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Key Facts",
          "type": "array"
        },
        "why_it_matters": {
          "maxLength": 700,
          "minLength": 10,
          "title": "Why It Matters",
          "type": "string"
        },
        "exam_tags": {
          "items": {
            "enum": [
              "SSC",
              "UPSC",
              "STATE_PSC",
              "BANKING",
              "RAILWAYS",
              "GENERAL"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Exam Tags",
          "type": "array"
        },
        "importance_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Importance Score",
          "type": "integer"
        },
        "quiz": {
          "items": {
            "$ref": "#/$defs/QuizOut"
          },
          "maxItems": 3,
          "title": "Quiz",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Uncertainties",
          "type": "array"
        },
        "sensitive_story": {
          "default": false,
          "title": "Sensitive Story",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "headline_banglish",
        "neutral_summary",
        "banglish_summary",
        "category",
        "key_facts",
        "why_it_matters",
        "importance_score"
      ],
      "title": "ArticleOut",
      "type": "object"
    },
    "KeyFactOut": {
      "properties": {
        "claim": {
          "maxLength": 320,
          "minLength": 10,
          "title": "Claim",
          "type": "string"
        },
        "source_item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Source Item Ids",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "source_item_ids"
      ],
      "title": "KeyFactOut",
      "type": "object"
    },
    "QuizOut": {
      "properties": {
        "question": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Options",
          "type": "array"
        },
        "correct_index": {
          "maximum": 3,
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 10,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_source_item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence Source Item Ids",
          "type": "array"
        }
      },
      "required": [
        "question",
        "options",
        "correct_index",
        "explanation",
        "evidence_source_item_ids"
      ],
      "title": "QuizOut",
      "type": "object"
    }
  },
  "properties": {
    "articles": {
      "items": {
        "$ref": "#/$defs/ArticleOut"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Articles",
      "type": "array"
    }
  },
  "required": [
    "articles"
  ],
  "title": "NewsBatchOut",
  "type": "object"
}
